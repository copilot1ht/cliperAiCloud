# ============================================================
# CLIPER AI CLOUD - LOCAL DEVELOPMENT
# Web     : http://localhost:3000
# API     : http://localhost:4100
# ============================================================


# ============================================================
# WEB
# ============================================================

# Browser menggunakan proxy /cloud-api.
NEXT_PUBLIC_API_URL=

# Next.js server-side proxy menuju API lokal.
CLIPER_API_URL=http://localhost:4100


# ============================================================
# API
# ============================================================

PORT=4100
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4100
NODE_ENV=development

# Password recovery defaults to an admin-issued, one-time temporary password.
# Email-link recovery is optional and only enabled when explicitly selected.
PASSWORD_RECOVERY_MODE=admin_assisted
PASSWORD_RESET_TEMP_TTL_MINUTES=30
RATE_LIMIT_ADMIN_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_PASSWORD_CHANGE_PER_15_MINUTES=5
APP_URL=http://localhost:3000
RESEND_API_KEY=
PASSWORD_RESET_FROM=
PASSWORD_RESET_REPLY_TO=
PASSWORD_RESET_EXPOSE_TOKEN_FOR_TESTS=false


# ============================================================
# STORAGE
# ============================================================
#
# LOCAL DEVELOPMENT:
# Gunakan PostgreSQL sebagai satu sumber data untuk identity, license,
# usage, billing, dan payment. Mode memory hanya untuk unit test terisolasi.
# ============================================================

AUTH_STORAGE=postgresql
LICENSE_STORAGE=postgresql
ANALYSIS_BILLING_STORAGE=postgres


# ============================================================
# SECURITY - LOCAL DEVELOPMENT ONLY
# ============================================================
#
# Jangan pakai nilai statis untuk secret. Jalankan `pnpm env:local`
# agar `.env` lokal dibuat dengan secret acak dan hash Argon2id.
# Generate ulang semua secret untuk staging/production.
# ============================================================

JWT_SECRET=change-me

REFRESH_TOKEN_SECRET=change-me

ADMIN_API_KEY=change-me

PROVIDER_ENCRYPTION_KEY=change-me

LICENSE_KEY_PEPPER=change-me

PAYMENT_SANDBOX_WEBHOOK_SECRET=change-me


# ============================================================
# DEVELOPMENT ADMIN
# ============================================================

DEV_ADMIN_EMAIL=admin@cliperaicloud.com

# Dihasilkan oleh `pnpm env:local`.
# Jangan dipakai untuk production.
DEV_ADMIN_PASSWORD_HASH=change-me


# ============================================================
# PRODUCTION ADMIN BOOTSTRAP
# ============================================================

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=


# ============================================================
# DEVELOPMENT API
# ============================================================

CLIPER_DEV_API_KEY=
CLIPER_DEV_PLAN=starter

ALLOW_LEGACY_API_KEY_AUTH=true


# ============================================================
# DESKTOP SESSION
# ============================================================

DESKTOP_ACCESS_TOKEN_MS=14400000
DESKTOP_REFRESH_TOKEN_MS=2592000000
DESKTOP_OFFLINE_GRACE_MS=259200000
# Gunakan PostgreSQL untuk mempertahankan sesi Electron ketika API di-restart.
DESKTOP_SESSION_STORAGE=postgres


# ============================================================
# RATE LIMIT
# ============================================================

RATE_LIMIT_STARTER_PER_MINUTE=5
RATE_LIMIT_PRO_PER_MINUTE=30
RATE_LIMIT_ENTERPRISE_PER_MINUTE=120
RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_15_MINUTES=3
RATE_LIMIT_KEY_CREATE_PER_HOUR=5
RATE_LIMIT_PAYMENT_CREATE_PER_10_MINUTES=5
RATE_LIMIT_PAYMENT_SYNC_PER_MINUTE=20
AI_CONCURRENCY_FREE=1
AI_CONCURRENCY_STARTER=2
AI_CONCURRENCY_PRO=4
AI_CONCURRENCY_TEAM=6
AI_CONCURRENCY_ENTERPRISE=10
AI_CONCURRENCY_TTL_MS=90000
AI_PROVIDER_RPS=30
AI_PROVIDER_CONCURRENCY=20
KEY_ACTIVITY_WRITE_INTERVAL_MS=600000
DESKTOP_HEARTBEAT_PERSIST_MS=600000
PROVIDER_RETRIES=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_MS=30000
ADMIN_CONFIG_REFRESH_MS=60000
HTTP_SUCCESS_LOG_SAMPLE_RATE=0.05


# ============================================================
# POSTGRESQL
# ============================================================
#
# Belum digunakan untuk identity/license pada local memory mode.
# Tetap disediakan agar nanti mudah mengaktifkan PostgreSQL.
# ============================================================

DATABASE_URL=postgresql://cliper:cliper@localhost:5432/cliper_cloud?schema=public

DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX=10


# ============================================================
# REDIS
# ============================================================

REDIS_URL=redis://localhost:6379


# ============================================================
# PAYMENT ENGINE
# ============================================================
#
# Payment DIMATIKAN untuk local test awal.
# ============================================================

PAYMENT_PROVIDER=sandbox
# PAYMENT_PRIMARY_PROVIDER takes precedence when set. Leave both at sandbox for
# local development; set both to xendit only after the Xendit test flow passes.
PAYMENT_PRIMARY_PROVIDER=
# Automatic provider fallback is deliberately unsupported. Every invoice is
# bound to one provider so QR, webhook verification, and the ledger stay exact.
PAYMENT_FALLBACK_ENABLED=false
ALLOW_SANDBOX_PAYMENTS=false

# Optional. If unset, PROVIDER_ENCRYPTION_KEY encrypts Admin Payment Settings.
# Set this separately in Railway when the admin form is used in production.
PAYMENT_CONFIG_ENCRYPTION_KEY=

# Leave these blank in source-controlled files. Set Production values only on
# Railway service @cliper/api, or save them through encrypted Admin Settings.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_ENABLED=true

MIDTRANS_IS_PRODUCTION=false
# QRIS Core API requires an acquirer. Use gopay by default; only switch after
# the corresponding QRIS channel has been enabled by Midtrans.
MIDTRANS_QRIS_ACQUIRER=gopay
MIDTRANS_NOTIFICATION_URL=
MIDTRANS_FINISH_REDIRECT_URL=

# Xendit Payments API V3 QRIS. These are backend-only Railway @cliper/api
# variables. Never expose them through NEXT_PUBLIC_ variables, Electron, or Git.
XENDIT_ENABLED=false
XENDIT_MODE=test
# Secret API Key only. A xnd_public_* key identifies browser clients and cannot
# create Payment Requests; generate a Money-In Write Secret Key in Xendit.
XENDIT_SECRET_KEY=
# Copy the current verification token from the matching Xendit environment.
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_VERSION=2024-11-11
XENDIT_NOTIFICATION_URL=

# Canonical Railway test configuration before a controlled live switch:
# PAYMENT_PROVIDER=xendit
# PAYMENT_PRIMARY_PROVIDER=xendit
# XENDIT_ENABLED=true
# XENDIT_MODE=test
# MIDTRANS_ENABLED=false
# PAYMENT_FALLBACK_ENABLED=false


# ============================================================
# TOP UP
# ============================================================

# Wallet is accounted in USD. QRIS remains IDR-only and receives the final
# amount after the service fee and server-generated unique code are included.
PAYMENT_MIN_TOPUP_USD=1
PAYMENT_MAX_TOPUP_USD=500
PAYMENT_USD_TO_IDR_DISPLAY_RATE=17700
PAYMENT_SERVICE_FEE_IDR=1000
PAYMENT_UNIQUE_CODE_ENABLED=true
PAYMENT_UNIQUE_CODE_MIN=99
PAYMENT_UNIQUE_CODE_MAX=299


# ============================================================
# AI PROVIDERS
# ============================================================
#
# Kosong dulu.
# Setelah API + Web stabil, provider ditambahkan dari Admin.
# Provider secret tidak boleh dikirim ke browser/Electron.
# ============================================================


# ---------------- DEEPSEEK ----------------

DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash


# ---------------- GEMINI ----------------

GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash


# ---------------- OPENAI ----------------

OPENAI_API_KEYS=
OPENAI_MODEL=gpt-5-mini


# ---------------- QWEN ----------------

QWEN_API_KEYS=
QWEN_MODEL=qwen3.7-plus


# ---------------- CLAUDE ----------------

CLAUDE_API_KEYS=
CLAUDE_MODEL=claude-sonnet-4-6


# ============================================================
# PROVIDER PRICING
# ============================================================
#
# Local development sementara mengizinkan pricing 0.
# Production WAJIB menggunakan harga provider sebenarnya.
# ============================================================

DEEPSEEK_INPUT_USD_PER_M=0
DEEPSEEK_CACHED_INPUT_USD_PER_M=0
DEEPSEEK_OUTPUT_USD_PER_M=0
DEEPSEEK_REASONING_USD_PER_M=0

GEMINI_INPUT_USD_PER_M=0
GEMINI_CACHED_INPUT_USD_PER_M=0
GEMINI_OUTPUT_USD_PER_M=0
GEMINI_REASONING_USD_PER_M=0

OPENAI_INPUT_USD_PER_M=0
OPENAI_CACHED_INPUT_USD_PER_M=0
OPENAI_OUTPUT_USD_PER_M=0
OPENAI_REASONING_USD_PER_M=0

QWEN_INPUT_USD_PER_M=0
QWEN_CACHED_INPUT_USD_PER_M=0
QWEN_OUTPUT_USD_PER_M=0
QWEN_REASONING_USD_PER_M=0

CLAUDE_INPUT_USD_PER_M=0
CLAUDE_CACHED_INPUT_USD_PER_M=0
CLAUDE_OUTPUT_USD_PER_M=0
CLAUDE_REASONING_USD_PER_M=0


# LOCAL ONLY
ALLOW_ZERO_PROVIDER_PRICING=true


# ============================================================
# PRICING / MARGIN ENGINE
# ============================================================

PLATFORM_USD_TO_IDR=17700


# ============================================================
# ANALYSIS BILLING
# ============================================================

ANALYSIS_JOB_STALE_MINUTES=720

# Saldo member disimpan sebagai micro-USD. Admin mengatur dan melihat konversi IDR.
# Jangan mengubah score editorial untuk mengatur harga job.
JOB_MINIMUM_MARGIN_BPS=5000
JOB_TARGET_MARGIN_BPS=6000
JOB_INFRASTRUCTURE_MICRO_USD=2000
JOB_PAYMENT_FEE_BPS=0
JOB_SAFETY_BUFFER_BPS=1000
JOB_RETRY_ALLOWANCE_BPS=500
JOB_MINIMUM_CHARGE_MICRO_USD=20000
# Reservation is the per-job estimate plus this headroom, never the maximum job ceiling.
JOB_RESERVATION_HEADROOM_BPS=2000
JOB_MAXIMUM_CHARGE_MICRO_USD=500000
JOB_TARGET_PROVIDER_COST_MICRO_USD=15000
JOB_WARNING_PROVIDER_COST_MICRO_USD=25000
JOB_HARD_PROVIDER_COST_MICRO_USD=50000
JOB_LOW_BALANCE_WARNING_MICRO_USD=1000000


# ============================================================
# WALLET
# ============================================================

LOW_BALANCE_WARNING_MICRO_USD=1000000

# Use the deployed Web origin in production. This local example remains local.
CLIPER_TOPUP_URL=http://127.0.0.1:3000/billing?source=desktop


# ============================================================
# CLIP ENGINE
# ============================================================

# 0 = adaptive
# Tidak membatasi jumlah recommendation secara hard-coded.
MAX_CLIPS_PER_JOB=0

MAX_SETTLEMENT_CLIP_SCORES=1000


# ============================================================
# LOCAL DEV CREDIT
# ============================================================

CLIPER_DEV_WALLET_BALANCE_MICRO_USD=1000000000000


# ============================================================
# PROVIDER ROUTER
# ============================================================

PROVIDER_RETRIES=2

ALLOW_CLIENT_MODEL_OVERRIDE=false


# ============================================================
# REQUEST LIMIT
# ============================================================

MAX_PROMPT_CHARS=120000
MAX_BODY_SIZE=256kb


# ============================================================
# DESKTOP BINARY DISTRIBUTION
# ============================================================

# URL release dikelola per versi di Admin > App releases dan disimpan di
# PostgreSQL. Jangan pakai environment variable global untuk URL binary.
# Source repository tetap private; simpan asset pada GitHub Releases, R2, atau
# host HTTPS publik lain yang mendukung download langsung.
