# Web
NEXT_PUBLIC_API_URL=
# Vercel server-side proxy target. In production, leave NEXT_PUBLIC_API_URL unset
# so the browser uses /cloud-api and cookies remain first-party.
CLIPER_API_URL=

# API
PORT=4100
WEB_ORIGIN=
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters
ADMIN_API_KEY=replace-admin-key
CLIPER_DEV_API_KEY=
CLIPER_DEV_PLAN=starter
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD_HASH=replace-with-argon2id-hash
# Production control-plane bootstrap account. Store only the Argon2id hash.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace-with-argon2id-hash
PROVIDER_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LICENSE_KEY_PEPPER=replace-with-at-least-32-random-characters
ALLOW_LEGACY_API_KEY_AUTH=true
DESKTOP_ACCESS_TOKEN_MS=900000
DESKTOP_REFRESH_TOKEN_MS=2592000000
DESKTOP_OFFLINE_GRACE_MS=259200000
RATE_LIMIT_STARTER_PER_MINUTE=5
RATE_LIMIT_PRO_PER_MINUTE=30
RATE_LIMIT_ENTERPRISE_PER_MINUTE=120

# Infrastructure
DATABASE_URL=postgresql://cliper:cliper@localhost:5432/cliper_cloud?schema=public
REDIS_URL=redis://localhost:6379

# Initial providers. Multiple keys are comma separated and rotated automatically.
DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-5-mini
QWEN_API_KEYS=
QWEN_MODEL=qwen3.7-plus
CLAUDE_API_KEYS=
CLAUDE_MODEL=claude-sonnet-4-6

# Provider cost in USD per 1M tokens. Adjust from the provider's current pricing.
DEEPSEEK_INPUT_USD_PER_M=0
DEEPSEEK_OUTPUT_USD_PER_M=0
GEMINI_INPUT_USD_PER_M=0
GEMINI_OUTPUT_USD_PER_M=0
DEFAULT_MARKUP_BPS=5000
COMPUTE_COST_MICRO_USD=0
PAYMENT_FEE_BPS=0
RISK_RESERVE_BPS=0
MINIMUM_REQUEST_MICRO_USD=0
MICRO_USD_PER_CREDIT=100
CLIPER_DEV_CREDIT_BALANCE_MICRO=1000000000000
PROVIDER_RETRIES=2
ALLOW_CLIENT_MODEL_OVERRIDE=false
MAX_PROMPT_CHARS=120000
MAX_BODY_SIZE=256kb
