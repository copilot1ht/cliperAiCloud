# ============================================================
# CLIPER AI CLOUD - LOCAL DEVELOPMENT
# Web     : http://localhost:3000
# API     : http://localhost:4100
# ============================================================


# ============================================================
# WEB
# ============================================================

# Browser menggunakan proxy /cloud-api.
NEXT_PUBLIC_API_URL=

# Next.js server-side proxy menuju API lokal.
CLIPER_API_URL=http://localhost:4100


# ============================================================
# API
# ============================================================

PORT=4100
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4100
NODE_ENV=development


# ============================================================
# STORAGE
# ============================================================
#
# LOCAL TEST:
# Identity/license menggunakan memory agar web + API bisa diuji
# tanpa menunggu PostgreSQL.
#
# Payment tetap jangan diuji sebelum PostgreSQL tersedia.
# ============================================================

AUTH_STORAGE=memory
LICENSE_STORAGE=memory
ANALYSIS_BILLING_STORAGE=memory


# ============================================================
# SECURITY - LOCAL DEVELOPMENT ONLY
# ============================================================
#
# Secret di bawah HANYA untuk local development.
# GENERATE ULANG sebelum staging/production.
# ============================================================

JWT_SECRET=local_cliper_jwt_2026_7cV8H2mK9pQ4xT6nR3sL5wF1aZ0dY8uB

REFRESH_TOKEN_SECRET=local_cliper_refresh_2026_N7pR2xK9mT4vQ8sL1wH6aD3yF5zC0bJ

ADMIN_API_KEY=local_cliper_admin_2026_M8xQ4pT7vR2nK9sH6wD3

PROVIDER_ENCRYPTION_KEY=local_cliper_provider_2026_Q9mK4xT7vR2pL8sH5wD1aF6zC3

LICENSE_KEY_PEPPER=local_cliper_license_2026_H7pQ2xM9vT4rK8sL5wD1aF6zN3

PAYMENT_SANDBOX_WEBHOOK_SECRET=local_cliper_payment_2026_R8mQ3xT7vK2pL9sH4wD1aF6zC5


# ============================================================
# DEVELOPMENT ADMIN
# ============================================================

DEV_ADMIN_EMAIL=admin@example.com

# Placeholder.
# Jangan dipakai untuk production.
DEV_ADMIN_PASSWORD_HASH=replace-with-argon2id-hash


# ============================================================
# PRODUCTION ADMIN BOOTSTRAP
# ============================================================

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace-with-argon2id-hash


# ============================================================
# DEVELOPMENT API
# ============================================================

CLIPER_DEV_API_KEY=
CLIPER_DEV_PLAN=starter

ALLOW_LEGACY_API_KEY_AUTH=true


# ============================================================
# DESKTOP SESSION
# ============================================================

DESKTOP_ACCESS_TOKEN_MS=14400000
DESKTOP_REFRESH_TOKEN_MS=2592000000
DESKTOP_OFFLINE_GRACE_MS=259200000


# ============================================================
# RATE LIMIT
# ============================================================

RATE_LIMIT_STARTER_PER_MINUTE=5
RATE_LIMIT_PRO_PER_MINUTE=30
RATE_LIMIT_ENTERPRISE_PER_MINUTE=120


# ============================================================
# POSTGRESQL
# ============================================================
#
# Belum digunakan untuk identity/license pada local memory mode.
# Tetap disediakan agar nanti mudah mengaktifkan PostgreSQL.
# ============================================================

DATABASE_URL=postgresql://cliper:cliper@localhost:5432/cliper_cloud?schema=public

DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX=10


# ============================================================
# REDIS
# ============================================================

REDIS_URL=redis://localhost:6379


# ============================================================
# PAYMENT ENGINE
# ============================================================
#
# Payment DIMATIKAN untuk local test awal.
# ============================================================

PAYMENT_PROVIDER=sandbox
ALLOW_SANDBOX_PAYMENTS=false

MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL=


# ============================================================
# TOP UP
# ============================================================

PAYMENT_MIN_TOPUP_IDR=25000

# Effective minimum target = US$3
PAYMENT_MIN_TOPUP_USD=3

PAYMENT_USD_TO_IDR_DISPLAY_RATE=17700

PAYMENT_MAX_TOPUP_IDR=10000000

PAYMENT_CREDITS_PER_IDR=1


# ============================================================
# AI PROVIDERS
# ============================================================
#
# Kosong dulu.
# Setelah API + Web stabil, provider ditambahkan dari Admin.
# Provider secret tidak boleh dikirim ke browser/Electron.
# ============================================================


# ---------------- DEEPSEEK ----------------

DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash


# ---------------- GEMINI ----------------

GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash


# ---------------- OPENAI ----------------

OPENAI_API_KEYS=
OPENAI_MODEL=gpt-5-mini


# ---------------- QWEN ----------------

QWEN_API_KEYS=
QWEN_MODEL=qwen3.7-plus


# ---------------- CLAUDE ----------------

CLAUDE_API_KEYS=
CLAUDE_MODEL=claude-sonnet-4-6


# ============================================================
# PROVIDER PRICING
# ============================================================
#
# Local development sementara mengizinkan pricing 0.
# Production WAJIB menggunakan harga provider sebenarnya.
# ============================================================

DEEPSEEK_INPUT_USD_PER_M=0
DEEPSEEK_CACHED_INPUT_USD_PER_M=0
DEEPSEEK_OUTPUT_USD_PER_M=0
DEEPSEEK_REASONING_USD_PER_M=0

GEMINI_INPUT_USD_PER_M=0
GEMINI_CACHED_INPUT_USD_PER_M=0
GEMINI_OUTPUT_USD_PER_M=0
GEMINI_REASONING_USD_PER_M=0

OPENAI_INPUT_USD_PER_M=0
OPENAI_CACHED_INPUT_USD_PER_M=0
OPENAI_OUTPUT_USD_PER_M=0
OPENAI_REASONING_USD_PER_M=0

QWEN_INPUT_USD_PER_M=0
QWEN_CACHED_INPUT_USD_PER_M=0
QWEN_OUTPUT_USD_PER_M=0
QWEN_REASONING_USD_PER_M=0

CLAUDE_INPUT_USD_PER_M=0
CLAUDE_CACHED_INPUT_USD_PER_M=0
CLAUDE_OUTPUT_USD_PER_M=0
CLAUDE_REASONING_USD_PER_M=0


# LOCAL ONLY
ALLOW_ZERO_PROVIDER_PRICING=true


# ============================================================
# PRICING / MARGIN ENGINE
# ============================================================

DEFAULT_MARKUP_BPS=5000
MINIMUM_MARGIN_BPS=5000

COMPUTE_COST_MICRO_USD=0

PAYMENT_FEE_BPS=0
RISK_RESERVE_BPS=0

MINIMUM_REQUEST_MICRO_USD=0

MINIMUM_CLIP_CHARGE_MICRO_USD=5000

MICRO_USD_PER_CREDIT=100

PLATFORM_USD_TO_IDR=16000


# ============================================================
# ANALYSIS BILLING
# ============================================================

ANALYSIS_BILLING_STORAGE=memory

ANALYSIS_JOB_STALE_MINUTES=720

CLIPER_CREDIT_VALUE_IDR=1

TARGET_GROSS_MARGIN_BPS=6000


# ============================================================
# ANALYSIS CREDIT RULES
# ============================================================

BASE_ANALYSIS_CREDITS=300

OPTIONAL_CLIP_CREDITS=50
GOOD_CLIP_CREDITS=100
PREMIUM_CLIP_CREDITS=150

OPTIONAL_SCORE_MIN=70
GOOD_SCORE_MIN=78
PREMIUM_SCORE_MIN=90

MINIMUM_JOB_CREDITS=300
MAXIMUM_JOB_CREDITS=2000


# ============================================================
# COST PROTECTION
# ============================================================

INFRASTRUCTURE_FEE_IDR=50

SAFETY_BUFFER_BPS=1000
RETRY_ALLOWANCE_BPS=500
PAYMENT_FEE_ALLOCATION_BPS=0

TARGET_PROVIDER_COST_IDR=250
WARNING_PROVIDER_COST_IDR=400
HARD_PROVIDER_COST_IDR=500


# ============================================================
# WALLET
# ============================================================

LOW_BALANCE_WARNING_CREDITS=5000

CLIPER_TOPUP_URL=http://localhost:3000/topup?source=desktop


# ============================================================
# CLIP ENGINE
# ============================================================

# 0 = adaptive
# Tidak membatasi jumlah recommendation secara hard-coded.
MAX_CLIPS_PER_JOB=0

MAX_SETTLEMENT_CLIP_SCORES=1000


# ============================================================
# LOCAL DEV CREDIT
# ============================================================

CLIPER_DEV_CREDIT_BALANCE_MICRO=1000000000000


# ============================================================
# PROVIDER ROUTER
# ============================================================

PROVIDER_RETRIES=2

ALLOW_CLIENT_MODEL_OVERRIDE=false


# ============================================================
# REQUEST LIMIT
# ============================================================

MAX_PROMPT_CHARS=120000
MAX_BODY_SIZE=256kb