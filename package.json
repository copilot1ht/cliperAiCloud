{
  "name": "cliper-ai-cloud",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo dev --concurrency=12",
    "dev:web": "pnpm --filter @cliper/web dev",
    "dev:api": "pnpm --filter @cliper/api dev",
    "build": "pnpm db:generate && turbo build",
    "typecheck": "pnpm db:generate && turbo typecheck",
    "test": "turbo test",
    "lint": "pnpm db:generate && turbo lint",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "env:local": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-local-env.ps1",
    "config:check": "pnpm --filter @cliper/api config:check",
    "build:web": "pnpm --filter @cliper/web build",
    "build:api": "pnpm --filter @cliper/api... build",
    "admin:hash": "pnpm --filter @cliper/api hash:password",
    "accounts:sync-bootstrap": "pnpm --filter @cliper/api accounts:sync-bootstrap",
    "accounts:seed": "pnpm --filter @cliper/api accounts:seed",
    "qa:local-cloud": "powershell -ExecutionPolicy Bypass -File scripts/local-cloud-smoke.ps1",
    "backup:postgres": "powershell -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1",
    "qa:signed-session": "powershell -ExecutionPolicy Bypass -File scripts/qa-signed-session.ps1",
    "qa:payment-local": "powershell -ExecutionPolicy Bypass -File scripts/qa-payment-local.ps1",
    "test:load": "node scripts/load-smoke.mjs",
    "qa": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
