{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.api",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/prisma/**",
      "/scripts/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json",
      "/Dockerfile.api"
    ]
  },
  "deploy": {
    "startCommand": "sh -c './node_modules/.bin/prisma migrate deploy && node apps/api/dist/main.js'",
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 15,
    "drainingSeconds": 15
  }
}
